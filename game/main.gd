	var shown := omen_pick.size()
	var walk_idx := shown + (1 if Stats.nemesis != "" else 0)
	if idx >= walk_idx:
		omen_refusals += 1
		if omen_refusals >= 2:
			toast("Twice refused. The old woman says nothing — that's rare.")
		else:
			toast("You walk alone — the Oracle nods")
		return
