func _defiance_deal(idx: int) -> void:
	if idx != 0:
		return
	_ach("defiant")
	Stats.buff_atk_pct += 0.25
	if boss_ref != null and is_instance_valid(boss_ref):
		boss_ref.enraged = true
		boss_ref.speed *= 1.4
