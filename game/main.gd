func _spawn_shrine(last_room: int) -> void:
	if rng.randf() >= 0.45:
		return
	var r: Dictionary = info.ranges[last_room]
	var pos := Vector3((r["x0"] + r["x1"]) * 0.5, 0.0, r["z0"] - 1.1 * info.tile)
