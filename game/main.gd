			_show_banner("FLOOR %d CLEARED" % Stats.floor_num, "%d kills this run • best combo ×%d • %d:%02d — tap to descend to Floor %d" % [kills_run, combo_max, int(run_time) / 60, int(run_time) % 60, Stats.floor_num + 1])
