var casts_run := 0
var skills_used := {}

func _skill_btn_deny(id: String) -> void:
	if skill_ui.has(id):
		var db: Node = skill_ui[id]["btn"]
		var dbx: float = db.position.x
		var dtw2: Tween = db.create_tween()
		for i in range(3):
			dtw2.tween_property(db, "position:x", dbx + (5.0 if i % 2 == 0 else -5.0), 0.04)
		dtw2.tween_property(db, "position:x", dbx, 0.05)

func _cast_skill(id: String) -> void:
	if player == null or not is_instance_valid(player) or player.dead or Stats.draft_open or run_state != "playing":
		return
	if float(player.get("silence_t")) > 0.0:
		Sfx.play("deny")
		_skill_btn_deny(id)
		toast("SILENCED — the Hex Priest seals your skills")
		return
	if not SK.is_unlocked(id, Stats.level):
		Sfx.play("deny")
		_skill_btn_deny(id)
		toast("%s unlocks at Lv %d" % [SK.DB[id]["name"], int(SK.DB[id]["unlock"])])
		return
	if skill_cd[id] > 0.0:
		Sfx.play("deny")
		_skill_btn_deny(id)
		return
	_quest_event("skill")
	# cast flash: model bersinar sesaat — respons skill terasa
	if player.get("mat") != null:
		player.mat.set_shader_parameter("flash", 0.7)
		var ctw: Tween = player.create_tween()
		ctw.tween_property(player.mat, "shader_parameter/flash", 0.0, 0.3)
	_burst(player.global_position + Vector3(0, 0.5, 0), Color(0.5, 0.7, 1.0))
	trauma = minf(trauma + 0.12, 0.45)
	if skill_ui.has(id):
		var sbtn: Node = skill_ui[id]["btn"]
		sbtn.pivot_offset = sbtn.size * 0.5
		sbtn.scale = Vector2(0.85, 0.85)
		var sbt: Tween = sbtn.create_tween()
		sbt.tween_property(sbtn, "scale", Vector2.ONE, 0.22).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	match id:
		"dash":
			var dir := Vector3(sin(player.rotation.y), 0, cos(player.rotation.y))
			if player.move_input.length() > 0.1:
				dir = Vector3(player.move_input.x, 0, player.move_input.y).normalized()
			player.dash_burst(dir)
			Sfx.play("dash")
			_burst(player.global_position + Vector3(0, 0.4, 0), Color(0.5, 0.9, 1.0))
		"whirl":
			if Stats.relics.has("signal_fire"):
				for ri_sig in range(info.ranges.size()):
					discovered[ri_sig] = true
				_update_minimap()
			player.anim_lock = M.play_action(player.ap, ["spin", "1h_melee_attack"], 1.6)
			Sfx.play("whirl")
			_shock_ring(player.global_position)
			var dmg := Stats.get_stat("atk") * 2.0
			var hit := 0
			for f in get_tree().get_nodes_in_group("enemies"):
				if f.global_position.distance_to(player.global_position) < 0.95 * info.tile:
					f.take_hit(player.global_position, dmg)
					hit += 1
			trauma = 0.6
			print("SKILL whirl hit=%d dmg=%.1f" % [hit, dmg])
		"thunder":
			var foes := get_tree().get_nodes_in_group("enemies")
			var pp: Vector3 = player.global_position
			foes.sort_custom(func(a, b) -> bool: return a.global_position.distance_squared_to(pp) < b.global_position.distance_squared_to(pp))
			var struck := 0
			for f in foes:
				if struck >= 3:
					break
				if f.global_position.distance_to(pp) > 2.5 * info.tile:
					break
				_lightning(f.global_position)
				f.take_hit(f.global_position, Stats.get_stat("atk") * 3.0)
				f.stun(1.4)
				struck += 1
			if struck == 0:
				Sfx.play("deny")
				toast("No enemies within thunder's reach")
				return
			Sfx.play("thunder")
			trauma = 0.9
			print("SKILL thunder struck=%d" % struck)
		"keelbolt":
			var kbfoes := get_tree().get_nodes_in_group("enemies")
			var kpp: Vector3 = player.global_position
			kbfoes.sort_custom(func(a, b) -> bool: return a.global_position.distance_squared_to(kpp) < b.global_position.distance_squared_to(kpp))
			var khit := false
			for kf in kbfoes:
				if kf.global_position.distance_to(kpp) > 3.0 * info.tile:
					break
				Sfx.play("hook", 0.8)
				kf.take_hit(kf.global_position, Stats.get_stat("atk") * 3.5)
				kf.stun(1.0)
				trauma = 0.5
				khit = true
				break
			if not khit:
				Sfx.play("deny")
				toast("No enemy within keelbolt's reach")
				return
		"galepulse":
			Sfx.play("swoosh", 0.9)
			var gpfoes := get_tree().get_nodes_in_group("enemies")
			var gpp: Vector3 = player.global_position
			var ghit := false
			for gf in gpfoes:
				var gd: Vector3 = gf.global_position - gpp
				gd.y = 0.0
				if gd.length() > 3.2 * info.tile:
					continue
				gf.take_hit(gf.global_position, Stats.get_stat("atk") * 1.5)
				gf.kb += gd.normalized() * 6.0
				ghit = true
			if ghit:
				trauma = 0.45
			else:
				toast("The gale finds no one to shove")
				return
		"keelover":
			Sfx.play("hook", 0.9)
			var kvfoes := get_tree().get_nodes_in_group("enemies")
			var kvpp: Vector3 = player.global_position
			var kvhit := false
			for kf in kvfoes:
				var kd: Vector3 = kvpp - kf.global_position
				kd.y = 0.0
				var kdist: float = kd.length()
				if kdist > 3.5 * info.tile or kdist < 0.3:
					continue
				kf.kb += kd.normalized() * 4.5
				kf.stun(0.8)
				kvhit = true
			if kvhit:
				trauma = 0.4
			else:
				toast("No foes within the anchor's reach")
				return
		"sounddeep":
			Sfx.play("thunder", 0.9)
			var sdfoes := get_tree().get_nodes_in_group("enemies")
			var sdpp: Vector3 = player.global_position
			var sdhit := false
			for sf in sdfoes:
				var sdd: Vector3 = sf.global_position - sdpp
				sdd.y = 0.0
				var sdist: float = sdd.length()
				if sdist > 4.5 * info.tile or sdist < 0.3:
					continue
				sf.take_hit(sdpp, Stats.get_stat("atk") * 1.5)
				sf.kb += sdd.normalized() * 5.0
				sf.stun(0.6)
				sdhit = true
			if sdhit:
				trauma = 0.45
			else:
				toast("The deep tolls for no one — no foes near")
				return
		"saltpall":
			Sfx.play("whisper", 0.85)
			var spfoes := get_tree().get_nodes_in_group("enemies")
			var sppp: Vector3 = player.global_position
			var sphit := false
			for spf in spfoes:
				var spd: Vector3 = spf.global_position - sppp
				spd.y = 0.0
				if spd.length() > 4.0 * info.tile:
					continue
				spf.take_hit(sppp, Stats.get_stat("atk") * 1.2)
				spf.set("slow_t", 3.0)
				sphit = true
			if sphit:
				trauma = 0.3
			else:
				toast("The pall falls on empty water — no foes near")
				return
		"keelhaul":
			var hf: Node3D = null
			var hfd := 1e9
			for f in get_tree().get_nodes_in_group("enemies"):
				if f.get("state") != "dead":
					var d2: float = player.global_position.distance_to(f.global_position)
					if d2 < hfd and d2 < 9.0:
						hfd = d2
						hf = f
			if hf != null:
				var dir2: Vector3 = player.global_position - hf.global_position
				hf.kb += dir2.normalized() * 18.0
				hf.stun(1.4)
				trauma = minf(trauma + 0.25, 0.5)
			Sfx.play("hook")
		"belltoll":
			Sfx.play("thunder")
			trauma = minf(trauma + 0.35, 0.6)
			var bpp: Vector3 = player.global_position
			for f in get_tree().get_nodes_in_group("enemies"):
				if f.get("state") != "dead" and bpp.distance_to(f.global_position) < 5.5 * info.tile:
					f.take_hit(f.global_position, Stats.get_stat("atk") * 1.4)
					var bd: Vector3 = bpp - f.global_position
					bd.y = 0.0
					f.kb += bd.normalized() * 4.0
		"dredge":
			var df: Node3D = null
			var dfd := 1e9
			for f in get_tree().get_nodes_in_group("enemies"):
				if f.get("state") != "dead":
					var dd2: float = player.global_position.distance_to(f.global_position)
					if dd2 < dfd and dd2 < 7.0 * info.tile:
						dfd = dd2
						df = f
			if df != null:
				df.take_hit(df.global_position, Stats.get_stat("atk") * 1.8)
				Stats.earn_souls(2)
				_damage_number(df.global_position + Vector3(0, info.tile, 0), "DREDGED +2◈", Color(0.6, 0.95, 0.7), false)
				Sfx.play("soul")
			else:
				toast("The dredge comes up empty — no foes near")
				return
		"grimpress":
			var gp_n := 0
			for gpf in get_tree().get_nodes_in_group("enemies"):
				if gpf.get("state") != "dead" and gpf.global_position.distance_to(player.global_position) < 4.0 * info.tile:
					gpf.take_hit(gpf.global_position, Stats.get_stat("atk") * 2.0)
					gpf.set("slow_t", maxf(float(gpf.get("slow_t") or 0.0), 2.0))
					gp_n += 1
			trauma = minf(trauma + 0.3, 0.6)
			if gp_n == 0:
				toast("The press finds only empty water — no foes near")
				return
			Sfx.play("thunder")
		"palemark":
			var pmf: Node3D = null
			var pmh := -1.0
			for pf2 in get_tree().get_nodes_in_group("enemies"):
				if pf2.get("state") != "dead" and pf2.global_position.distance_to(player.global_position) < 6.0 * info.tile:
					var ph2 := float(pf2.get("hp"))
					if ph2 > pmh:
						pmh = ph2
						pmf = pf2
			if pmf != null:
				pmf.set("hex_t", 6.0)
				_damage_number(pmf.global_position + Vector3(0, info.tile, 0), "PALE MARK", Color(0.9, 0.9, 1.0), true)
				Sfx.play("whisper")
			else:
				toast("Nothing worth marking — no foes in sight")
				return
		"greywake":
			var gwh := 0
			for gf in get_tree().get_nodes_in_group("enemies"):
				if gf.get("state") != "dead" and gf.global_position.distance_to(player.global_position) < 5.0 * info.tile:
					gf.take_hit(gf.global_position, Stats.get_stat("atk") * 1.2)
					gf.set("slow_t", maxf(float(gf.get("slow_t") or 0.0), 3.0))
					gwh += 1
			if gwh > 0:
				Sfx.play("swoosh")
				trauma = minf(trauma + 0.25, 1.0)
				_damage_number(player.global_position + Vector3(0, info.tile, 0), "GREY WAKE", Color(0.55, 0.7, 0.65), true)
			else:
				toast("The wake finds nothing — no foes in reach")
				return
		"crestwake":
			var cwh := 0
			for cf in get_tree().get_nodes_in_group("enemies"):
				if cf.get("state") != "dead" and cf.global_position.distance_to(player.global_position) < 5.0 * info.tile:
					cf.set("slow_t", maxf(float(cf.get("slow_t") or 0.0), 2.5))
					cwh += 1
			Stats.buff_speed_pct += 0.08
			Sfx.play("swoosh")
			trauma = minf(trauma + 0.2, 1.0)
			_damage_number(player.global_position + Vector3(0, info.tile, 0), "CRESTWAKE", Color(0.65, 0.9, 0.85), true)
		"wakecut":
			var wcd: Vector3 = Vector3(sin(player.rotation.y), 0, cos(player.rotation.y))
			var wcn := 0
			for wf in get_tree().get_nodes_in_group("enemies"):
				if wf.get("state") != "dead":
					var wto: Vector3 = wf.global_position - player.global_position
					wto.y = 0.0
					if wto.length() < 4.0 * info.tile and wto.normalized().dot(wcd) > 0.2:
						wf.take_hit(wf.global_position, Stats.get_stat("atk") * 1.6)
						wf.kb += wcd * 12.0
						wcn += 1
			if wcn > 0:
				Sfx.play("swing")
				trauma = minf(trauma + 0.3, 1.0)
				_damage_number(player.global_position + wcd * (1.5 * info.tile) + Vector3(0, info.tile, 0), "WAKE CUT", Color(0.6, 0.85, 0.8), true)
			else:
				toast("The cut finds nothing — no foes ahead")
				return
